// 開発用の環境（Cloudflare Workers の静的アセット）の設定。手元から `npm run deploy:dev` で配置する
// 本番は Cloudflare Pages（GitHub 連携）で、この設定は使わない（docs/DEPLOY.md）
// サーバー側の処理は持たない。dist/ の静的ファイルを配るだけ
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "four-coloring-game-dev",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist" }
}
